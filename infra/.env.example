# Copiar este archivo como .env (en esta misma carpeta) y cambiar todos los valores antes de desplegar.
# El archivo .env no se sube al repositorio.

MYSQL_ROOT_PASSWORD=cambiar-clave-root
DB_CLAVE_USUARIOS=cambiar-clave-usuarios
DB_CLAVE_EVENTOS=cambiar-clave-eventos

# Secreto para firmar los JWT, de al menos 32 caracteres. Lo comparten ms-usuarios y ms-eventos.
JWT_SECRETO=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
